---
import type { Game } from '../types/game';
import Tag from './Tag.astro';
import ArrowRight from '../assets/icons/arrow-right.svg';

interface Props {
    game: Game;
}

const { game } = Astro.props;
---

<article
    class="group relative block bg-slate-800/60 backdrop-blur-sm rounded-xl overflow-hidden shadow-lg border border-slate-700/50 hover:border-blue-500/50 hover:shadow-blue-500/10 hover:shadow-xl transition-all duration-300 hover:translate-y-[-6px] focus:ring-2 focus:ring-blue-500 focus:outline-none"
    data-testid="game-card"
    data-game-id={game.id}
    data-game-title={game.title}
    tabindex="0"
>
    <a
        href={`/game/${game.id}`}
        class="absolute inset-0 z-0 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none"
        aria-label={`View details for ${game.title}`}
        data-testid="game-card-link"
    ></a>
    <div class="relative z-10 p-6 pointer-events-none">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 to-purple-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
            <h3 class="text-xl font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors" data-testid="game-title">{game.title}</h3>

            {(game.category?.name || game.publisher?.name) && (
                <div class="flex gap-2 mb-3">
                    {game.category?.name && (
                        <Tag color="blue" data-testid="game-category">
                            {game.category.name}
                        </Tag>
                    )}
                    {game.publisher?.name && (
                        <a
                            href={`/publisher/${game.publisher.id}`}
                            class="relative z-20 pointer-events-auto rounded focus:ring-2 focus:ring-blue-500 focus:outline-none"
                            aria-label={`View games by ${game.publisher.name}`}
                            data-testid="game-publisher-link"
                        >
                            <Tag color="purple" data-testid="game-publisher">
                                {game.publisher.name}
                            </Tag>
                        </a>
                    )}
                </div>
            )}

            <p class="text-slate-400 mb-4 text-sm line-clamp-2" data-testid="game-description">{game.description}</p>

            <div class="mt-4 text-sm text-blue-400 font-medium flex items-center">
                <span>View details</span>
                <ArrowRight class="h-4 w-4 ml-1 transform transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true" />
            </div>
        </div>
    </div>
</article>

<script>
    document.querySelectorAll<HTMLElement>('[data-testid="game-card"]').forEach((card) => {
        card.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                card.querySelector<HTMLAnchorElement>('[data-testid="game-card-link"]')?.click();
            }
        });
    });
</script>
